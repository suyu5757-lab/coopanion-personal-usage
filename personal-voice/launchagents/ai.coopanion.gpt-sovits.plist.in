<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.coopanion.gpt-sovits</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Library/Application Support/Coopanion/tts/gpt-sovits/venv/bin/python</string>
    <string>api_v2.py</string>
    <string>-a</string><string>127.0.0.1</string>
    <string>-p</string><string>9880</string>
    <string>-c</string><string>__HOME__/Library/Application Support/Coopanion/tts/gpt-sovits/tts_infer.yaml</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/Library/Application Support/Coopanion/tts/gpt-sovits/repo</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Application Support/Coopanion/tts/gpt-sovits/server.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Application Support/Coopanion/tts/gpt-sovits/server.log</string>
</dict>
</plist>
