+export function sourceAttachment(
+  text: string,
+  source: Omit<EvidenceAttachment, 'segment'>,
+  start = 0,
+  end = text.length,
+): EvidenceAttachment {
+  return { ...source, segment: { start, end, digest: digestText(text.slice(start, end)) } };
