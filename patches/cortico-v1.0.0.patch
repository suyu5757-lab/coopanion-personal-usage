+}
+
+export function inspectContextEvidence(
+  records: readonly ContextRecord[],
+  options: {
+    ignoreSystem?: boolean;
+    ignoreHead?: boolean;
+    generationEvidence?: readonly GenerationEvidenceEnvelope[];
+    verifyDependency?: SourceDependencyVerifier;
+    canonicalizeSource?: (source: SourceExposureRef) => SourceExposureRef | null;
+  } = {},
+): EvidenceInspection {
+  const kept = records.filter(record => !(options.ignoreSystem && record.item.type === 'message' && record.item.role === 'system')
+    && !(options.ignoreHead && record.context.head));
+  return inspectEvidence(
+    kept,
+    kept.map(inputItem),
+    [],
+    false,
+    options.generationEvidence ?? [],
+    options.verifyDependency,
+    undefined,
+    undefined,
+    options.canonicalizeSource,
+  );
+}
+
+export function combineEvidenceStates(...states: EvidenceMappingState[]): EvidenceMappingState {
+  if (states.includes('ambiguous')) return 'ambiguous';
+  if (states.includes('stale')) return 'stale';
+  if (states.includes('unverified')) return 'unverified';
+  if (states.includes('missing')) return 'missing';
+  return 'complete';
+}
+
+function inspectEvidence(
+  records: readonly ContextRecord[],
+  inputs: readonly Item[],
+  bodyStrings: readonly { field: string; value: string }[],
+  requireBody: boolean,
+  generationEvidence: readonly GenerationEvidenceEnvelope[],
+  verifyDependency?: SourceDependencyVerifier,
+  serializedBodyDigest?: string,
+  serializedBody?: unknown,
