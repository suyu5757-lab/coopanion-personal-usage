@@ -0,0 +1,136 @@
+import { randomUUID } from 'node:crypto';
+import type { SessionGenerationStatus } from './types.ts';
+
+export const GENERATION_DRAIN_TIMEOUT_MS = 2_000;
+
+export interface GenerationLease {
+  token: string;
+  signal: AbortSignal;
+}
+
+export interface GenerationSnapshot {
+  generation: { token: string; status: SessionGenerationStatus };
+  previousGeneration?: { token: string; status: 'invalidated' | 'unknown' };
+}
+
+interface WorkEntry {
+  token: string;
+  kind: 'provider' | 'tool';
+  interruptible: boolean;
+  settled: Promise<void>;
+}
+
+export type GenerationInvalidationOutcome =
+  | { status: 'acknowledged'; invalidatedGeneration: string; newGeneration: string; receiptRef: string }
+  | { status: 'unsupported'; reason: string }
+  | { status: 'failed' | 'unknown'; reason: string; currentGeneration?: string; receiptRef?: string };
+
+/** Core-owned cancellation boundary for one live session instance. */
+export class SessionGenerationScope {
+  readonly sessionId: string;
+  readonly role: string;
+  private currentLease: GenerationLease;
+  private controller = new AbortController();
+  private currentStatus: SessionGenerationStatus = 'current';
+  private previousGeneration: GenerationSnapshot['previousGeneration'];
+  private closed = false;
+  private readonly works = new Map<symbol, WorkEntry>();
+  private readonly invalidationListeners = new Set<(lease: GenerationLease) => void>();
+
+  constructor(sessionId: string, role: string) {
+    this.sessionId = sessionId;
+    this.role = role;
+    this.currentLease = this.createLease();
+  }
+
+  lease(): GenerationLease {
+    return this.currentLease;
+  }
+
+  snapshot(): GenerationSnapshot {
+    return {
+      generation: { token: this.currentLease.token, status: this.currentStatus },
+      ...(this.previousGeneration ? { previousGeneration: this.previousGeneration } : {}),
+    };
+  }
+
+  isCurrent(token: string): boolean {
+    return !this.closed && this.currentStatus === 'current' && this.currentLease.token === token;
+  }
+
+  onInvalidate(listener: (lease: GenerationLease) => void): () => void {
+    this.invalidationListeners.add(listener);
+    return () => this.invalidationListeners.delete(listener);
+  }
+
+  trackWork<T>(lease: GenerationLease, kind: WorkEntry['kind'], interruptible: boolean, work: Promise<T>): Promise<T> {
+    if (!this.isCurrent(lease.token)) return work;
+    const id = Symbol(kind);
+    const settled = work.then(() => undefined, () => undefined);
+    this.works.set(id, { token: lease.token, kind, interruptible, settled });
+    void settled.then(() => this.works.delete(id));
+    return work;
+  }
+
+  async invalidate(
+    expectedGeneration: string,
+    receiptRef: string,
+    drainTimeoutMs = GENERATION_DRAIN_TIMEOUT_MS,
+  ): Promise<GenerationInvalidationOutcome> {
+    if (this.closed) return { status: 'unsupported', reason: 'session instance is no longer active' };
+    if (this.currentLease.token !== expectedGeneration || this.currentStatus !== 'current') {
+      return {
+        status: 'failed',
+        reason: 'expected generation is not current',
+        currentGeneration: this.currentLease.token,
+        receiptRef,
+      };
+    }
+
+    const invalidated = this.currentLease;
+    this.currentStatus = 'invalidating';
+    this.controller.abort(new Error('generation invalidated'));
+    for (const listener of this.invalidationListeners) {
+      try { listener(invalidated); } catch { /* A cancellation observer cannot keep the generation live. */ }
+    }
+    await Promise.resolve();
+    const pending = [...this.works.values()].filter(work => work.token === invalidated.token);
+    let drained = pending.length === 0;
+    if (!drained) {
+      let timer: ReturnType<typeof setTimeout> | undefined;
+      const timeout = new Promise<false>(resolve => {
+        timer = setTimeout(() => resolve(false), drainTimeoutMs);
+      });
+      drained = await Promise.race([
+        Promise.all(pending.map(work => work.settled)).then(() => true as const),
+        timeout,
+      ]);
+      if (timer) clearTimeout(timer);
+    }
+    const status = drained ? 'invalidated' : 'unknown';
+    this.previousGeneration = { token: invalidated.token, status };
+    if (this.closed && !drained) {
+      this.currentStatus = 'unknown';
+      return { status: 'unknown', reason: 'session instance ended before invalidation completed', receiptRef };
+    }
+    this.currentLease = this.createLease();
+    this.currentStatus = this.closed ? 'unknown' : 'current';
+    const pendingKinds = pending.map(work => `${work.kind}${work.interruptible ? '' : ' (uninterruptible)'}`).join(', ');
+    const reason = this.closed
+      ? 'session instance ended before invalidation completed'
+      : `generation work did not reach a terminal state before the drain deadline: ${pendingKinds}`;
+    return drained
+      ? { status: 'acknowledged', invalidatedGeneration: invalidated.token, newGeneration: this.currentLease.token, receiptRef }
+      : { status: 'unknown', reason, currentGeneration: this.currentLease.token, receiptRef };
+  }
+
+  close(): void {
+    this.closed = true;
+    if (this.currentStatus === 'current') this.currentStatus = 'unknown';
+  }
+
+  private createLease(): GenerationLease {
+    this.controller = new AbortController();
+    return { token: `generation:${randomUUID()}`, signal: this.controller.signal };
+  }
+}
