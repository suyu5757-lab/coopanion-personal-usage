+
+export function joinResponseAttempt(responseId: string, attempts: readonly ProviderAttempt[]): ResponseAttemptJoin {
+  const matches = attempts.filter(attempt => attempt.responseId === responseId);
+  if (matches.length === 0) return { status: 'missing' };
+  if (matches.length !== 1) return { status: 'ambiguous' };
+  return { status: 'matched', attempt: matches[0] };
+}
+
+export function joinAttemptId(attemptId: string, attempts: readonly ProviderAttempt[]): ResponseAttemptJoin {
+  const matches = attempts.filter(attempt => attempt.id === attemptId);
+  if (matches.length === 0) return { status: 'missing' };
+  if (matches.length !== 1) return { status: 'ambiguous' };
+  return { status: 'matched', attempt: matches[0] };
+}
+
+export function inspectRequestEvidence(
+  request: Request,
+  records: readonly ContextRecord[],
+  body: unknown,
+  generationEvidence: readonly GenerationEvidenceEnvelope[] = [],
+  verifyDependency?: SourceDependencyVerifier,
+  trustedToolDigests?: readonly string[],
+  sessionId?: string,
+  canonicalizeSource?: (source: SourceExposureRef) => SourceExposureRef | null,
+): EvidenceInspection {
+  const input = request.input;
+  if (!Array.isArray(input) || input.length !== records.length) {
+    return {
+      mappingState: 'missing', exposedSources: [],
+      items: records.map(record => ({ itemId: record.item.id ?? '', disposition: 'unknown-derived-incomplete', mappingState: 'missing', exposedSources: [], spans: [] })),
+      serializedBodyDigest: digestText(typeof body === 'string' ? body : JSON.stringify(body ?? null)),
+    };
+  }
+  let parsedBody = body;
+  if (typeof body === 'string') {
+    try { parsedBody = JSON.parse(body); }
+    catch { parsedBody = null; }
+  }
+  const evidenceById = new Map(generationEvidence.map(envelope => [envelope.id, envelope]));
+  const reasoningTextsByIndex = records.map((record, index) => {
+    if (record.item.type !== 'reasoning') return undefined;
+    const item = input[index];
+    if (!item || item.type !== 'reasoning') return undefined;
+    const generated = generatedCoverage(record, item, evidenceById);
+    if (!generated) return undefined;
+    const texts = reasoningTexts(record.item);
+    const allowed = new Set([texts.summary, texts.content].filter(text => text.length > 0));
+    return allowed.size ? allowed : undefined;
+  });
