+import { itemText } from '../../src/protocol/open-responses/context.ts';
+import { Core } from './fixture-core.ts';
+import type { CoreApi, InvalidateGenerationInput, InvalidateGenerationResult, ToolCallContext, ToolDef, World, WorldHost } from '../../src/core/types.ts';
+import { GENERATION_INVALIDATED } from '../../src/core/markers.ts';
+import { GENERATION_DRAIN_TIMEOUT_MS } from '../../src/core/generation-scope.ts';
+import { messages } from './fixture-protocol.ts';
+import {
+  assertPairing,
+  FakeLLM,
+  type FakePersonaOptions,
+  makeCfg,
+  makeFakePersona,
+  makeLoaded,
+  makeTmpDir,
+  sleep,
+  toolReply,
+} from './helpers.ts';
+
+const active = new Set<{ core: Core; cleanup: () => void }>();
+
+function invalidate(api: CoreApi, input: InvalidateGenerationInput): Promise<InvalidateGenerationResult> {
+  return api.invalidateGeneration?.(input)
+    ?? Promise.resolve({ status: 'unsupported', reason: 'CoreApi does not expose generation invalidation' });
+}
+
+function build(
+  opts: { tool: ToolDef; eager?: boolean; extraSessions?: FakePersonaOptions['extraSessions'] },
+  existingRoot?: string,
+) {
+  const tmp = existingRoot ? { dir: existingRoot, cleanup: () => {} } : makeTmpDir();
+  const config = makeCfg();
+  config.worlds.qq.enabled = false;
+  let host: WorldHost | null = null;
+  const world: World = {
+    id: 'probe',
+    envPromptVars: () => ({}),
+    tools: () => [opts.tool],
+    start: async value => { host = value; },
+    stop: async () => {},
+  };
+  const persona = makeFakePersona([], {
+    cfg: config,
+    worlds: [world],
+    silent: true,
+    ...(opts.extraSessions ? { extraSessions: opts.extraSessions } : {}),
+    ...(opts.eager ? { mainPatch: { outputTap: { onDelta: () => {} } } } : {}),
+  });
+  let api: CoreApi | null = null;
+  const attach = persona.attach.bind(persona);
+  persona.attach = value => { api = value; attach(value); };
+  const loaded = makeLoaded({
+    config,
+    rootDir: tmp.dir,
+    memoryDir: join(tmp.dir, 'persona'),
+    dataDir: join(tmp.dir, 'data'),
+  });
+  const llm = new FakeLLM();
+  const core = new Core(loaded, { persona, worlds: [world], llm });
+  const entry = { core, cleanup: tmp.cleanup };
+  active.add(entry);
+  return {
+    core,
+    llm,
+    rootDir: tmp.dir,
+    api: () => {
+      if (!api) throw new Error('CoreApi was not attached');
+      return api;
+    },
+    host: () => {
+      if (!host) throw new Error('World has not started');
+      return host;
+    },
+    cleanup: entry.cleanup,
+  };
+}
+
+async function push(host: WorldHost): Promise<void> {
+  await host.pushEvent({
+    type: 'probe.message',
+    ts: new Date().toISOString(),
+    source: 'probe',
+    text: 'run tool',
+  });
+}
+
+function toolLog(core: Core): string {
+  const path = join(core.run.dir, 'toolcalls.jsonl');
+  return existsSync(path) ? readFileSync(path, 'utf8') : '';
+}
+
+describe('Core session generation invalidation', () => {
+  afterEach(async () => {
+    for (const entry of active) {
+      await entry.core.stop();
+      entry.cleanup();
+    }
+    active.clear();
+  });
+
+  it('issues a fresh token after restart and makes invalidation idempotent', async () => {
+    const tool: ToolDef = { name: 'noop', description: '', tags: ['act'], parameters: {}, handler: async () => 'ok' };
+    const first = build({ tool });
+    const old = first.api().sessionInfo('main').generation!.token;
+    const input = { sessionId: 'main', expectedGeneration: old, reason: 'forget' as const, idempotencyKey: 'forget-1' };
+    const result = await invalidate(first.api(), input);
+    expect(result.status).toBe('acknowledged');
+    if (result.status !== 'acknowledged') throw new Error('expected acknowledgement');
+    expect(result.invalidatedGeneration).toBe(old);
+    expect(result.newGeneration).not.toBe(old);
+    expect(result.receiptRef).toMatch(/^generation-receipt:/);
+    expect(await invalidate(first.api(), input)).toEqual(result);
+
+    const current = first.api().sessionInfo('main');
+    expect(current.generation).toEqual({ token: result.newGeneration, status: 'current' });
+    expect(current.previousGeneration).toEqual({ token: old, status: 'invalidated' });
+    expect(await invalidate(first.api(), { ...input, expectedGeneration: result.newGeneration }))
+      .toMatchObject({ status: 'failed', reason: expect.stringContaining('reused') });
+    expect(await invalidate(first.api(), { ...input, idempotencyKey: 'forget-2' }))
+      .toMatchObject({ status: 'failed', currentGeneration: result.newGeneration });
+    expect(await invalidate(first.api(), { ...input, sessionId: 'missing', idempotencyKey: 'forget-3' }))
+      .toMatchObject({ status: 'unsupported' });
+
+    await first.core.stop();
+    const second = build({ tool }, first.rootDir);
+    const restarted = second.api().sessionInfo('main').generation!.token;
+    expect(restarted).not.toBe(old);
+    expect(await invalidate(second.api(), { ...input, idempotencyKey: 'restart-stale' }))
+      .toMatchObject({ status: 'failed', currentGeneration: restarted });
+  });
