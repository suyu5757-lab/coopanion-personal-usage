+/** Matches inline image bytes against a full content-addressed log handle. */
+export function matchesLogImageDataUrl(ref: BlobRef, url: string): boolean {
+  const ext = EXT_BY_MIME[ref.mime];
+  if (!ref.mime.startsWith('image/') || !ext || !ref.handle.startsWith(LOG_SCHEME)) return false;
+  const prefix = `data:${ref.mime};base64,`;
+  if (!url.startsWith(prefix)) return false;
+  const encoded = url.slice(prefix.length);
+  const bytes = Buffer.from(encoded, 'base64');
+  if (!bytes.length || bytes.toString('base64') !== encoded) return false;
+  const hash = createHash('sha256').update(bytes).digest('hex').slice(0, LOG_HASH_CHARS);
+  return ref.handle === `${LOG_SCHEME}${hash}${ext}`;
+}
