+
+function collectStringLeaves(value: unknown, field = '$', out: Array<{ field: string; value: string }> = []): Array<{ field: string; value: string }> {
+  if (typeof value === 'string') out.push({ field, value });
+  else if (Array.isArray(value)) value.forEach((item, index) => collectStringLeaves(item, `${field}[${index}]`, out));
