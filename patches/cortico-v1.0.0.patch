+
+function addExposure(
+  source: SourceExposureRef,
+  itemSources: Map<string, SourceExposureRef>,
+  exposed: Map<string, SourceExposureRef>,
+  tupleDigests: Map<string, string>,
+  addState: (state: EvidenceMappingState) => void,
+  canonicalizeSource?: (source: SourceExposureRef) => SourceExposureRef | null,
+): SourceExposureRef {
+  if (!validSourceRefs([source])) { addState('unverified'); return source; }
+  const canonical = canonicalizeSource?.(source);
+  if (canonical && validSourceRefs([canonical]) && canonical.bankId === source.bankId
+    && canonical.endpoint === source.endpoint && canonical.documentId === source.documentId
+    && canonical.contentDigest === source.contentDigest) source = canonical;
