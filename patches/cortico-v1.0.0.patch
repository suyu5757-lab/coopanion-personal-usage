+
+/** Process-local metadata only; no request text or source body is retained. */
+export class GenerationEvidenceStore {
+  private readonly sessions = new Map<string, GenerationEvidenceEnvelope[]>();
+
+  record(envelope: GenerationEvidenceEnvelope): void {
+    const entries = this.sessions.get(envelope.sessionId) ?? [];
+    const at = entries.findIndex(entry => entry.id === envelope.id);
+    const copy = structuredClone(envelope);
+    if (at >= 0) entries[at] = copy;
+    else entries.push(copy);
+    if (entries.length > 200) entries.splice(0, entries.length - 200);
+    if (!this.sessions.has(envelope.sessionId) && this.sessions.size >= 64) {
+      const oldest = this.sessions.keys().next().value as string | undefined;
+      if (oldest !== undefined) this.sessions.delete(oldest);
+    }
+    this.sessions.delete(envelope.sessionId);
+    this.sessions.set(envelope.sessionId, entries);
+  }
+
+  findByIds(ids: readonly string[]): readonly GenerationEvidenceEnvelope[] {
+    const wanted = new Set(ids);
+    const found = new Map<string, GenerationEvidenceEnvelope | null>();
+    for (const entries of this.sessions.values()) for (const envelope of entries) {
+      if (!wanted.has(envelope.id)) continue;
+      found.set(envelope.id, found.has(envelope.id) ? null : envelope);
+    }
+    return [...found.values()].filter((entry): entry is GenerationEvidenceEnvelope => entry !== null).map(entry => structuredClone(entry));
+  }
+
+  get(sessionId: string): readonly GenerationEvidenceEnvelope[] {
+    const entries = this.sessions.get(sessionId) ?? [];
+    if (this.sessions.has(sessionId)) {
+      this.sessions.delete(sessionId);
+      this.sessions.set(sessionId, entries);
+    }
+    return structuredClone(entries);
+  }
+}
