+        if (startedCount === 1) startedResolve(ctx);
+        await new Promise<void>(resolve => {
+          if (ctx.generationSignal?.aborted) resolve();
+          else ctx.generationSignal?.addEventListener('abort', () => resolve(), { once: true });
+        });
+        ctx.queueExternalEvents?.([{
+          cursor: 42, type: 'probe.message', ts: new Date().toISOString(), source: 'probe', origin: 'external',
+          text: 'stale tool callback event',
