+function structuredArgumentProofs(body: unknown, input: Extract<Item, { type: 'function_call' }>): SerializedValueProof[] {
+  let parsed: unknown;
+  try { parsed = JSON.parse(input.arguments); } catch { return []; }
+  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return [];
+  const canonical = (value: unknown): string => JSON.stringify(value, (_key, item) => item && typeof item === 'object' && !Array.isArray(item)
+    ? Object.fromEntries(Object.entries(item).sort(([left], [right]) => left < right ? -1 : left > right ? 1 : 0)) : item);
+  const expected = canonical(parsed);
+  const proofs: SerializedValueProof[] = [];
+  const visit = (value: unknown, path: string): void => {
+    if (!value || typeof value !== 'object') return;
+    if (Array.isArray(value)) { value.forEach((entry, index) => visit(entry, `${path}[${index}]`)); return; }
