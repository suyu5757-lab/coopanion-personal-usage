+    const matches = (candidate: unknown): boolean => !!candidate && typeof candidate === 'object' && !Array.isArray(candidate)
+      && canonical(candidate) === expected;
+    if (item.type === 'tool_use' && item.id === input.call_id && item.name === input.name && matches(item.input)) {
+      proofs.push({ field: `${path}.input`, valueDigest: digestText(expected), inputDigest: digestText(input.arguments) });
+    }
+    const call = item.functionCall;
+    if (call && typeof call === 'object' && !Array.isArray(call)) {
+      const fn = call as Record<string, unknown>;
+      if (fn.id === input.call_id && fn.name === input.name && matches(fn.args)) {
+        proofs.push({ field: `${path}.functionCall.args`, valueDigest: digestText(expected), inputDigest: digestText(input.arguments) });
+      }
+    }
+    for (const [key, child] of Object.entries(item)) visit(child, `${path}.${key}`);
+  };
+  visit(body, '$');
+  return proofs;
+}
