+  const world: World | null = options.world ?? (worldTools.length > 0 ? {
+    id: 'probe', envPromptVars: () => null, tools: () => worldTools,
+    start: async (host: WorldHost) => { rig.host = host; }, stop: async () => {},
+  } : null);
+  const persona = makeFakePersona(options.personaTools ?? [], {
