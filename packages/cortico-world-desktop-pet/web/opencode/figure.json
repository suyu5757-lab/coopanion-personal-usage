    "en": "a small terminal: a charcoal shell, a pale screen, two square eyes, a blinking cursor, a plug tail and an antenna; the screen shows what it is doing"
  },
  "author": "Pal-AI-Lab",
  "entry": "figure.js",
  "export": "createOpencodeBody",
  "axes": [],
  "presets": [],
