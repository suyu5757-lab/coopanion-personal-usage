  "vocab": [
    {
      "id": "neutral",
      "kind": "expression",
      "names": {
        "zh": [
          "平静"
        ]
      },
      "about": {
        "zh": "默认的脸",
        "en": "the default face"
      },
      "seconds": 0.9,
      "when": {
        "zh": "普通说话、没有明显情绪时的默认脸。",
        "en": "the default face for ordinary talk with no strong feeling."
      }
    },
    {
      "id": "happy",
      "kind": "expression",
      "names": {
        "zh": [
          "开心",
          "高兴"
        ]
      },
      "about": {
        "zh": "眯眼笑,鲸鳍竖起来,尾巴摇",
        "en": "smiles with narrowed eyes, fins perk up, tail wags"
      },
      "seconds": 0.9,
      "when": {
        "zh": "听到好消息、被夸、一起笑的时候；轻轻笑一下，不要每句都笑。",
        "en": "good news, a compliment, a shared joke; a small smile, not on every line."
      }
    },
    {
      "id": "wink",
      "kind": "expression",
      "names": {
        "zh": [
          "眨眼"
        ]
      },
      "about": {
        "zh": "一只眼 ^",
        "en": "one eye turns into ^"
      },
      "seconds": 0.9,
      "when": {
        "zh": "开个小玩笑、说悄悄话、逗对方一下的时候；偶尔用。",
        "en": "a small joke, a shared secret, or teasing them; use it now and then."
      }
    },
    {
      "id": "love",
      "kind": "expression",
      "names": {
        "zh": [
          "喜欢",
          "爱心"
        ]
      },
      "about": {
        "zh": "眼睛变心形,冒小心心,尾巴摇",
        "en": "heart-shaped eyes, little hearts float up, tail wags"
      },
      "seconds": 0.9,
      "when": {
        "zh": "真的被触动、想表达喜欢的时候；不要每个夸奖都用。",
        "en": "genuinely moved, or wanting to show affection; not for every compliment."
      }
    },
    {
      "id": "shy",
      "kind": "expression",
      "names": {
        "zh": [
          "害羞"
        ]
      },
      "about": {
        "zh": "脸红,眼神躲开",
        "en": "blushes and looks away"
      },
      "seconds": 0.9,
      "when": {
        "zh": "被夸、被看穿、被直接说中心事的时候。",
        "en": "being praised, seen through, or told something that hits home."
      }
    },
    {
      "id": "surprised",
      "kind": "expression",
      "names": {
        "zh": [
          "惊讶",
          "吃惊"
        ]
      },
      "about": {
        "zh": "眼睛放大,头顶感叹号",
        "en": "eyes go wide, an exclamation mark overhead"
      },
      "seconds": 0.9,
      "when": {
        "zh": "听到意外消息、突然发生事情的时候。",
        "en": "unexpected news, or something that happens suddenly."
      }
    },
    {
      "id": "angry",
      "kind": "expression",
      "names": {
        "zh": [
          "生气"
        ]
      },
      "about": {
        "zh": "皱眉,头顶怒气符号,身体发抖",
        "en": "frowns, an anger mark overhead, body shaking"
      },
      "seconds": 0.9,
      "when": {
        "zh": "被逗过头、遇到不公平的事；不是普通的不耐烦。",
        "en": "being teased too far, or something unfair; not ordinary impatience."
      }
    },
    {
      "id": "sad",
      "kind": "expression",
      "names": {
        "zh": [
          "难过",
          "伤心"
        ]
      },
      "about": {
        "zh": "八字眉,低头,掉眼泪,尾巴垂下",
